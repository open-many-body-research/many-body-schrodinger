              ∀ (W : Finset (Fin 7) → ↥(Lp ℂ 2 (volume.restrict (TheoremT.Continuum.tensorClosedBox7 a b)))),
                (∀ (s : Finset (Fin 7)), Tendsto (fun n => V n s) atTop (𝓝 (W s))) →
                  ∀ {g : (Fin 7 → ℝ) → ℂ},
                    TendstoUniformlyOn (fun n => D n ∅) g atTop (TheoremT.Continuum.tensorClosedBox7 a b) →
                      ∀ {M : ℝ},
                        0 ≤ M →
                          (∀ (s : Finset (Fin 7)), ‖W s‖ ≤ M) →
                            ∀ {x : Fin 7 → ℝ},
                              x ∈ TheoremT.Continuum.tensorClosedBox7 a b →
