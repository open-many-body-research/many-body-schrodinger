    (@Finset.prod.{0, 0} (Fin n) Complex _ (@Finset.univ.{0} (Fin n) _) fun (j : Fin n) => x j (w j))
@TheoremT.Continuum.coordinateWordMultilinear_norm_le.{u_1} : ∀ {σ : Type u_1} [inst : Fintype.{u_1} σ] {n : Nat}
