@TheoremT.Continuum.homogeneous_polynomial_multilinear_exists.{u_1} : ∀ {σ : Type u_1} [inst : Fintype.{u_1} σ]
  (P : @MvPolynomial.{u_1, 0} σ Complex _) {n : Nat} (hP : @MvPolynomial.IsHomogeneous.{u_1, 0} σ Complex _ P n),
  @Exists.{u_1 + 1}
    (@ContinuousMultilinearMap.{0, 0, u_1, 0} Complex (Fin n) (fun (x : Fin n) => σ → Complex) Complex _ _ _ _ _ _ _)
    fun
      (L :
        @ContinuousMultilinearMap.{0, 0, u_1, 0} Complex (Fin n) (fun (x : Fin n) => σ → Complex) Complex _ _ _ _ _ _
          _) =>
    And
      (∀ (z : σ → Complex),
        @Eq.{1} Complex
          (@DFunLike.coe.{u_1 + 1, u_1 + 1, 1}
            (@ContinuousMultilinearMap.{0, 0, u_1, 0} Complex (Fin n) (fun (x : Fin n) => σ → Complex) Complex _ _ _ _ _
              _ _)
            ((i : Fin n) → σ → Complex) (fun (x : (i : Fin n) → σ → Complex) => Complex) _ L fun (x : Fin n) => z)
          (@DFunLike.coe.{u_1 + 1, u_1 + 1, 1} (@RingHom.{u_1, 0} (@MvPolynomial.{u_1, 0} σ Complex _) Complex _ _)
            (@MvPolynomial.{u_1, 0} σ Complex _) (fun (x : @MvPolynomial.{u_1, 0} σ Complex _) => Complex) _
            (@MvPolynomial.eval.{0, u_1} Complex σ _ z) P))
      (@LE.le.{0} Real _
        (@Norm.norm.{u_1}
          (@ContinuousMultilinearMap.{0, 0, u_1, 0} Complex (Fin n) (fun (x : Fin n) => σ → Complex) Complex _ _ _ _ _ _
            _)
          _ L)
        (@TheoremT.Continuum.polynomialCoeffL1.{u_1} σ P))
