@TheoremT.Continuum.polynomialCoeffL1_neg.{u_1} : ∀ {σ : Type u_1} (p : @MvPolynomial.{u_1, 0} σ Complex _),
  @Eq.{1} Real (@TheoremT.Continuum.polynomialCoeffL1.{u_1} σ (@Neg.neg.{u_1} (@MvPolynomial.{u_1, 0} σ Complex _) _ p))
