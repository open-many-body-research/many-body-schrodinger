  [inst_3 : @NormedSpace.{0, u_2} Real F _ _] {f : E → F}
  {p : @FormalMultilinearSeries.{0, u_1, u_2} Real E F _ _ _ _ _ _ _ _ _ _ _}
  (hf : @HasFPowerSeriesAt.{0, u_1, u_2} Real E F _ _ _ _ _ f p (@OfNat.ofNat.{u_1} E (nat_lit 0) _))
  (heven :
    @Filter.EventuallyEq.{u_1, u_2} E F (@nhds.{u_1} E _ (@OfNat.ofNat.{u_1} E (nat_lit 0) _))
      (fun (x : E) => f (@Neg.neg.{u_1} E _ x)) f)
  {n : Nat} (hn : @Odd.{0} Nat _ n) (y : E),
