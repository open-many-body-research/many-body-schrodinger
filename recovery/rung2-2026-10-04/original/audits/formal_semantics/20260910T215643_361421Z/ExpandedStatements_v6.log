  {f : E → F} (hf : @AnalyticOnNhd.{0, u_1, u_2} Real E F _ _ _ _ _ f K),
  @Exists.{u_1 + 1} (Set.{u_1} E) fun (U : Set.{u_1} E) =>
    And (@Membership.mem.{u_1, u_1} (Set.{u_1} E) (Filter.{u_1} E) _ (@nhdsSet.{u_1} E _ K) U)
